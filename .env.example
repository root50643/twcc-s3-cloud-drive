# Web session
SESSION_SECRET=replace-with-a-long-random-secret

# S3-compatible storage
S3_ENDPOINT=https://cos.twcc.ai
S3_BUCKET=replace-with-bucket-name
S3_ROOT_PREFIX=uploads/
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_EXPIRES_SECONDS=300

# Runtime
FRONTEND_PORT=8080
USERS_FILE=/app/config/users.json
