# Web session
SESSION_SECRET=replace-with-at-least-24-random-characters
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
TRUST_PROXY_HOPS=1

# Authentication and audit retention
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_PER_USERNAME=10
LOGIN_RATE_LIMIT_PER_IP=30
AUDIT_RETENTION_DAYS=180

# S3-compatible storage
S3_ENDPOINT=https://cos.twcc.ai
S3_BUCKET=replace-with-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_EXPIRES_SECONDS=300

# Runtime
FRONTEND_PORT=8080
DATABASE_FILE=/app/data/app.sqlite
